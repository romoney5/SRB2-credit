{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "srb2",
  "version": "1.0.0",
  "builtin-baseline": "40a9bd4ccdf5dc14ff76d4ed47d46a226ce84a83",
  "dependencies": [
    {
      "name": "curl",
      "platform": "!wasm32"
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "mbedtls"
      ],
      "platform": "wasm32",
      "version>=": "7.74.0#5"
    },
    "libpng",
    "miniupnpc",
    {
      "name": "sdl2",
      "platform": "!linux"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "features": [
        "wayland",
        "x11"
      ],
      "platform": "linux",
      "version>=": "2.30.6#2"
    },
    "libvpx",
    "libvorbis",
    "libyuv",
    "zlib"
  ]
}
